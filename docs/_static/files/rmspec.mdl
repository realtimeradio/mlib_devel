	      MaskCallbackString      "|||||||myname=gcb;\nif strcmp(get_param(myname, 'use_sim'), 'off')\n    masks = get_param(myname, 'MaskEnables');\n    masks{9} = 'on';\n    set_param(myname, 'MaskEnables', masks);\nelse\n    masks = get_param(myname, 'MaskEnables');\n    masks{9} = 'off';\n    set_param(myname, 'MaskEnables', masks);\nend|||myname=gcb;\nif strcmp(get_param(myname, 'wide_data'), 'off')\n    masks = get_param(myname, 'MaskEnables');\n    masks{12} = 'on';\n    set_param(myname, 'MaskEnables', masks);\nelse\n    set_param(myname, 'half_burst', 'off');\n    masks = get_param(myname, 'MaskEnables');\n    masks{12} = 'off';\n    set_param(myname, 'MaskEnables', masks);\nend||"
