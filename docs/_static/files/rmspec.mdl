		    MaskType		    "delay_bram"
		    MaskDescription	    "A delay block that uses BRAM for its storage."
		    MaskHelp		    "eval('xlWeb([getenv(''MLIB_ROOT''), ''\\doc\\html\\sp_delay_bram\\sp_delay_bram.html''])')"
