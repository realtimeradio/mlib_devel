		  MaskInitialization	  "twiddle_general_4mult_init(gcb, ...\n    'Coeffs', Coeffs, ...\n    'StepPeriod', StepPeriod"
		  ", ...\n    'coeffs_bram', coeffs_bram, ...\n    'coeff_bit_width', coeff_bit_width, ...\n    'input_bit_width', in"
		  "put_bit_width, ...\n    'add_latency', add_latency, ...\n    'mult_latency', mult_latency, ...\n    'bram_latency'"
