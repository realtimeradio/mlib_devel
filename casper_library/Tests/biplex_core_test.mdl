	  " = get_param(gcb, 'use_hdl');\nif strcmp(use_hdl, 'on'),\n    set_param_state(gcb, 'use_embedded', 'off');\nelse\n "
	  "   set_param_state(gcb, 'use_embedded', 'on');\nend|% make mutually exclusive with use_hdl.\n\nuse_hdl = get_param("
