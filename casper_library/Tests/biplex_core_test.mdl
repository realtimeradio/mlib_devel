	      "ift, ...\n    'add_latency', add_latency, ...\n    'mult_latency', mult_latency, ...\n    'bram_latency', bram_"
	      "latency, ...\n    'conv_latency', conv_latency, ...\n    'quantization', quantization, ...\n    'overflow', ove"
	      "rflow, ...\n    'arch', arch, ...\n    'opt_target', opt_target, ...\n    'coeffs_bram', coeffs_bram, ...    \n"
	      "    'use_hdl', use_hdl, ...\n    'use_embedded', use_embedded, ...\n    'dsp48_adders', dsp48_adders);"
