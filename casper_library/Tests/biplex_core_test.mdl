	      "e mutually exclusive with use_hdl.\n\nuse_hdl = get_param(gcb, 'use_embedded');\nif strcmp(use_hdl, 'on'),\n   "
	      " set_param_state(gcb, 'use_hdl', 'off');\nelse\n    set_param_state(gcb, 'use_hdl', 'on');\nend|hardcode_shifts"
	      " = get_param(gcb, 'hardcode_shifts');\nset_param_state(gcb, 'downshift', hardcode_shifts);|fft_callback_dsp48_a"
	      "dders(gcb);"
