		  "cy, ...\n    'overflow', overflow, ...\n    'quantization', quantization);\n    "
		  MaskIconFrame		  on
		  MaskIconOpaque	  on
		  MaskIconRotate	  "none"
		  MaskPortRotate	  "default"
		  MaskIconUnits		  "autoscale"
		  MaskValueString	  "22|18|16|15|2|Saturate|Round  (unbiased: +/- Inf)"
